{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/john1hsu/salesforce-quiz-api/schema/question-file.schema.json",
  "title": "Question file",
  "description": "One YAML file per knowledge-graph article: questions/<domain>/<article-slug>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["article", "questions"],
  "properties": {
    "article": {
      "description": "Knowledge-graph node id the questions are grounded in.",
      "type": "string",
      "pattern": "^kt:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "type", "difficulty", "stem", "options", "answer", "explanation", "sources", "created", "updated"],
      "properties": {
        "id": {
          "description": "Permanent id. Never change or delete it; set status: retired instead.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$"
        },
        "status": { "enum": ["published", "retired"] },
        "type": {
          "description": "single = exactly one correct option; multiple = two or more, and the stem says how many.",
          "enum": ["single", "multiple"]
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "stem": { "type": "string", "minLength": 20, "maxLength": 800 },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-f]$" },
              "text": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-f]$" },
          "uniqueItems": true
        },
        "explanation": { "type": "string", "minLength": 40, "maxLength": 1500 },
        "exams": {
          "description": "Extra exam slugs from exams.yaml. Exams the article is coveredBy in the graph are added automatically.",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "sources": {
          "description": "Source ids (s1, s2, ...) from the article's frontmatter that support the answer.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^s[0-9]+$" },
          "uniqueItems": true
        },
        "created": { "type": "string", "format": "date" },
        "updated": {
          "description": "Bump on any content change so client apps can sync incrementally.",
          "type": "string",
          "format": "date"
        },
        "retiredReason": { "type": "string" }
      }
    }
  }
}
